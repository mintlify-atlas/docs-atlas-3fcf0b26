  "keyFeatures": [
    "Jetpack Compose UI with Material3 theming",
    "MVVM architecture with StateFlow-based unidirectional data flow",
    "androidx.navigation3 type-safe navigation with NavKey destinations",
    "In-memory caching repository with configurable TTL and stale-on-error fallback",
    "Exponential-backoff retry on IOException",
    "SharedPreferences-backed favorites store with StateFlow reactivity",
    "GitHub Actions PR Quiz workflow that gates merge on reviewer answers",
    "Debounced search filtering across quote text and author fields",
    "Manual dependency injection via AppContainer (no DI framework)",
    "Comprehensive unit tests using kotlinx-coroutines-test"
  ],
  "publicApiSurface": [
    "QuoteRepository.getQuotes(forceRefresh: Boolean): List<Quote>",
    "QuoteRepository.getQuote(id: String): Quote?",
    "CachingQuoteRepository(api, cacheTtlMillis, now)",
    "FavoritesStore.favoriteIds: StateFlow<Set<String>>",
    "FavoritesStore.setFavorite(id: String, isFavorite: Boolean)",
    "retryOnIoError(attempts, initialDelayMillis, factor, block)",
    "QuoteApi.fetchQuotes(): List<Quote>",
    "QuoteListViewModel.state: StateFlow<QuoteListState>",
    "QuoteListViewModel.onQueryChange(newQuery: String)",
    "QuoteListViewModel.onRefresh()",
    "QuoteListViewModel.onToggleFavorite(quoteId: String)",
    "QuoteDetailViewModel.state: StateFlow<QuoteDetailState>",
    "QuoteDetailViewModel.onToggleFavorite()",
    "NavKey: QuoteList (data object)",
    "NavKey: QuoteDetail(quoteId: String)",
    "GitHub Actions workflow: pr-quiz.yml (triggers on pull_request, issue_comment)",
    "/answer <n><letter> comment command for quiz submission"
  ]
}
