{
  "projectType": "general",
  "projectName": "PR Quiz Demo",
  "projectDescription": "A demo Android app built with Jetpack Compose and MVVM that doubles as a GitHub Actions-powered PR quiz, challenging reviewers to answer questions about the diff before a pull request can be merged.",
  "theme": "palm",
  "primaryColor": "#6650A4",
  "lightColor": "#D0BCFF",
